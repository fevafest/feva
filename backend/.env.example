# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:4200

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/feva-fest

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# PayHero (https://docs.payhero.africa/)
PAYHERO_API_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://your-public-domain.com/api/payments/payhero/callback

# Platform fee (percentage applied to subtotal, e.g. 0.05 = 5%)
PLATFORM_FEE_PERCENT=0.05
PLATFORM_FEE_FIXED=0

# Email (SMTP) - used to send ticket QR codes after a confirmed payment.
# Works with any SMTP provider: Gmail app password, SendGrid/Mailgun/Resend
# SMTP relay, AWS SES SMTP, Mailtrap (for testing), etc. Leave blank to
# disable email sending (tickets still generate normally, just aren't emailed).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=FEVA FEST <no-reply@fevafest.co.ke>
